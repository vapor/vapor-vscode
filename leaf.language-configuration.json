{
    "comments": {
        "blockComment": ["#comment:", "#endcomment"]
    },
    "brackets": [
        ["(", ")"]
    ],
    "autoClosingPairs": [
        ["(", ")"],
        ["\"", "\""]
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["\"", "\""]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*(<!--\\s*#region\\b.*-->|#comment:\\s*(\\\\)*#region\\b.*#endcomment)",
            "end": "^\\s*(<!--\\s*#endregion\\b.*-->|#comment:\\s*(\\\\)*#endregion\\b.*#endcomment)"
        }
    },
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\$\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\s]+)"
}
